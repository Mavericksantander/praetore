# libFuzzer dictionary for fuzz_targets/path_prefix.rs.
# Input format: "prefix\npath", or a bare path checked against fixed prefixes.
sep="/"
dsep="//"
dot="."
dotdot=".."
seg_dot="/."
seg_dotdot="/.."
seg_dotdot_slash="/../"
triple_dot="..."
backslash="\\"
backslash_dotdot="\\.."
percent="%"
pct_dot="%2e"
pct_dot_upper="%2E"
pct_slash="%2f"
nul="\x00"
newline="\x0a"
space_dotdot=" .."
srv="/srv"
agent="/srv/agent"
agent_slash="/srv/agent/"
agent_x="/srv/agentx"
upper="/SRV/\xc3\x84gent"
abc="/a/b/c"
fullwidth_dot="\xef\xbc\x8e"
division_slash="\xe2\x88\x95"
combining_diaeresis="\xcc\x88"
