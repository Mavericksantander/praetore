{
  "mcpServers": {
    "repo-tools": {
      "command": "node",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/tools/mcp.js"
      ],
      "env": {
        "TOKEN": "${REPO_TOKEN}"
      }
    },
    "shared-api": {
      "type": "http",
      "url": "${API_BASE_URL:-https://api.example.com}/mcp",
      "headers": {
        "Authorization": "Bearer ${API_KEY}"
      }
    }
  }
}
