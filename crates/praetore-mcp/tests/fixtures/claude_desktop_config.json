{
  "globalShortcut": "Ctrl+Space",
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/me/Desktop"],
      "env": { "DEBUG": "1" }
    },
    "no-args": {
      "command": "/usr/local/bin/my-server",
      "customField": { "kept": true }
    }
  },
  "zzz": [1, 2.5, null, "x"]
}
